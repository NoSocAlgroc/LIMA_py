# Whitelist-style .gitignore: ignore everything by default, then explicitly
# un-ignore only the python files needed to run the core LIMA algorithm.
# Excluded on purpose: MonoScheduler, APRIORISampler/FPSampler, benchmark
# code, mock/plotting scripts, datasets, notebooks, and any result artifact
# (pickles, pngs) or cache (__pycache__).
*

!.gitignore

# allow traversing into every directory so the rules below can match
!*/

!main.py

!LIMA/__init__.py
!LIMA/LIMA.py

!LIMA/lattice/__init__.py
!LIMA/lattice/Lattice.py
!LIMA/lattice/LatticeState.py
!LIMA/lattice/LIMALatticeState.py

!LIMA/sampler/__init__.py
!LIMA/sampler/Sampler.py
!LIMA/sampler/Sample.py
!LIMA/sampler/LIMASampler.py

!LIMA/scheduler/__init__.py
!LIMA/scheduler/Scheduler.py
!LIMA/scheduler/Schedule.py
!LIMA/scheduler/LIMAScheduler.py

!data/__init__.py
!data/TPSet.py

!data/dataset/__init__.py
!data/dataset/Dataset.py

!data/domain/__init__.py
!data/domain/Domain.py
!data/domain/DomainSet.py
!data/domain/DomainSubSet.py
!data/domain/TPDomain.py
!data/domain/TPDomainSet.py

!data/predicate/__init__.py
!data/predicate/PredicateGroup.py
!data/predicate/UnorderedPG.py
!data/predicate/OrderedPG.py
!data/predicate/EviSet.py

!npstruct/list/List1D.py
!npstruct/list/ListND.py
!npstruct/dict/Dict1D.py
!npstruct/dict/Dict1DS.py

!util/__init__.py
!util/nptypes.py

!util/list/__init__.py
